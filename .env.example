# Copy to .env.local and replace the placeholders before starting/building.
# NEXT_PUBLIC_* values are public and embedded at build time. Never put secrets here.
# Configure these in the deployment BUILD environment; rebuild after changes.

# Required: backend base URL, including any API path prefix.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Required: separate chatbot backend base URL.
NEXT_PUBLIC_API_BASE_AI_URL=https://chat.example.com

# Required: public Square application ID for the selected environment.
NEXT_PUBLIC_SQUARE_APP_ID=replace-with-your-square-application-id
# Required: sandbox or production. Match the backend Square environment and credentials.
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# Optional: fallback hero image URL; leave empty to keep the existing fallback behavior.
NEXT_PUBLIC_IMAGEURL=
